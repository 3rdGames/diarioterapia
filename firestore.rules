rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dias já analisados ficam travados: não podem mais ser alterados (só apagados junto com a conta).
    match /users/{uid}/entries/{day} {
      allow read, create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && resource.data.get('locked', false) != true;
    }
    match /users/{uid}/reports/{month} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
